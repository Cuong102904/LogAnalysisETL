COMPOSE_PROJECT_NAME=log-streaming-platform

# Topology
DATA_PLATFORM_HOST=100.120.19.23
OBJECT_STORE_HOST=100.120.19.23
BI_PLATFORM_HOST=100.121.19.84
HIVE_METASTORE_PORT=9083
TRINO_PORT=8080
SUPERSET_PORT=8088
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9011

# Airflow
FERNET_KEY=replace_with_generated_fernet_key
AIRFLOW__API_AUTH__JWT_SECRET=replace_with_strong_jwt_secret
AIRFLOW__API_AUTH__JWT_ISSUER=airflow
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True
AIRFLOW__CORE__EXECUTOR=LocalExecutor
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=change-me

# Superset
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=change-me
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_SECRET_KEY=replace_with_strong_superset_secret
SUPERSET_DB_NAME=superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=change-me
SUPERSET_SQLALCHEMY_DATABASE_URI=postgresql+psycopg2://superset:change-me@superset-db:5432/superset
SUPERSET_TRINO_DATABASE_NAME=trino_delta_mooc
SUPERSET_TRINO_SQLALCHEMY_URI=trino://superset@trino:8080/delta/mooc

# Network
LINUX_DOCKER_HOST=100.120.19.23
SPARK_MASTER_ADVERTISE_HOST=100.120.19.23
SPARK_MASTER_BIND_HOST=spark-master

# Kafka
KAFKA_EXTERNAL_HOST=100.120.19.23
KAFKA_BOOTSTRAP_SERVERS_HOST=100.120.19.23:9092,100.120.19.23:9093,100.120.19.23:9094
KAFKA_BOOTSTRAP_SERVERS_DOCKER=broker1:29092,broker2:29092,broker3:29092
KAFKA_TOPIC_RAW=mooc.raw.events

# Object store / MinIO
OBJECT_STORE_ACCESS_KEY=minio
OBJECT_STORE_SECRET_KEY=change-me
OBJECT_STORE_PATH_STYLE_ACCESS=true
OBJECT_STORE_SSL_ENABLED=false
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me
MINIO_REGION=us-east-1
MINIO_BUCKET_DATA=lakehouse
MINIO_BUCKET_PLATFORM=platform
HIVE_WAREHOUSE_DIR=s3a://lakehouse/learnlake

# Spark
SPARK_MASTER_URL=spark://100.120.19.23:7077
AIRFLOW_CONN_SPARK_DEFAULT=spark://100.120.19.23:7077
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_MEM_LIMIT=2304m
SPARK_WORKER_CORES=2
SPARK_DRIVER_MEMORY=768m
SPARK_EXECUTOR_MEMORY=1g
GOLD_STREAM_SPARK_DRIVER_MEMORY=1024m
GOLD_ALERTING_SPARK_DRIVER_MEMORY=1024m
BRONZE_SPARK_UI_PORT=4040
SILVER_SPARK_UI_PORT=4041
GOLD_SPARK_UI_PORT=4042
GOLD_ALERTING_SPARK_UI_PORT=4043
SPARK_JARS_PACKAGES=io.delta:delta-spark_2.12:3.2.0,org.apache.spark:spark-sql-kafka-0-10_2.12:3.5.1,org.apache.hadoop:hadoop-aws:3.3.4,com.amazonaws:aws-java-sdk-bundle:1.12.262

# Gold
GOLD_VIDEO_BUCKET_SECONDS=5
GOLD_TRIGGER_INTERVAL_SECONDS=30
GOLD_ALERTING_TRIGGER_INTERVAL_SECONDS=30
GOLD_ALERTING_MIN_EVENT_COUNT=3
GOLD_ALERTING_MIN_DISTINCT_USERS=2
GOLD_ALERTING_MIN_Z_SCORE=2.0
GOLD_BEHAVIOR_ANOMALIES_PATH=s3a://lakehouse/mooc/gold/behavior_anomalies
GOLD_VIDEO_ANOMALY_FEATURES_PATH=s3a://lakehouse/mooc/gold/video_anomaly_features
GOLD_PDF_BEHAVIOR_FEATURES_PATH=s3a://lakehouse/mooc/gold/pdf_behavior_features
GOLD_QUIZ_PERFORMANCE_FEATURES_PATH=s3a://lakehouse/mooc/gold/quiz_performance_features
GOLD_LEARNING_JOURNEY_FEATURES_PATH=s3a://lakehouse/mooc/gold/learning_journey_features
GOLD_ALERT_EVENTS_PATH=s3a://lakehouse/mooc/gold/alert_events
GOLD_ALERTING_CHECKPOINT_BASE=s3a://platform/mooc/gold_alerting

# Hive Metastore / Trino
HIVE_METASTORE_DB_HOST=hive-metastore-db
HIVE_METASTORE_DB_PORT=5432
HIVE_METASTORE_DB_NAME=hive_metastore
HIVE_METASTORE_DB_USER=hive
HIVE_METASTORE_DB_PASSWORD=hivepassword
TRINO_S3_REGION=us-east-1
TRINO_S3_PATH_STYLE_ACCESS=true
TRINO_S3_ACCESS_KEY=minio
TRINO_S3_SECRET_KEY=change-me

# Container limits
KAFKA_HEAP_OPTS=-Xms128m -Xmx256m
KAFKA_BROKER1_MEM_LIMIT=512m
KAFKA_BROKER_MEM_LIMIT=512m
KAFKA_INIT_MEM_LIMIT=256m
KAFKA_UI_MEM_LIMIT=300m
MINIO_INIT_MEM_LIMIT=192m
SPARK_MASTER_MEM_LIMIT=512m
SPARK_HISTORY_MEM_LIMIT=512m
SPARK_STREAM_DRIVER_MEM_LIMIT=768m
GOLD_STREAM_MEM_LIMIT=1536m
GOLD_ALERTING_MEM_LIMIT=1536m
AIRFLOW_INIT_MEM_LIMIT=256m
AIRFLOW_MEM_LIMIT=1024m

# Bronze
BRONZE_TABLE_PATH=s3a://lakehouse/mooc/bronze/mooc_events_raw
BRONZE_CHECKPOINT_PATH=s3a://platform/mooc/bronze_ingestor
BRONZE_CHECKPOINT_PREFIX=mooc/bronze_ingestor/offsets/
BRONZE_OPTIMIZE_ENABLED=true
BRONZE_VACUUM_ENABLED=false
BRONZE_VACUUM_RETENTION_HOURS=168

# LearnLake framework runtime
LEARNLAKE_SPARK_MASTER_URL=spark://100.120.19.23:7077
