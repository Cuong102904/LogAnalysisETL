AIRFLOW_UID=50000
FERNET_KEY=replace_with_generated_fernet_key
AIRFLOW__API_AUTH__JWT_SECRET=replace_with_strong_jwt_secret
AIRFLOW__API_AUTH__JWT_ISSUER=airflow
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
AIRFLOW_IMAGE_NAME=datn-airflow:local
AIRFLOW_PROJ_DIR=.
ENV_FILE_PATH=.env
PHASE1_NETWORK=mooc-streaming-phase1_default

# Bronze stream endpoints
KAFKA_BOOTSTRAP_SERVERS=broker1:29092,broker2:29092,broker3:29092
KAFKA_TOPIC_RAW=mooc.raw.events
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123456
MINIO_REGION=us-east-1
BRONZE_TABLE_BUCKET=bronze
BRONZE_TABLE_PREFIX=mooc/bronze/mooc_events_raw/
CHECKPOINT_BUCKET=checkpoints
CHECKPOINT_PREFIX=mooc/bronze_ingestor/offsets/

# Health check thresholds
KAFKA_OFFSET_MIN_DELTA=1
OFFSET_PROBE_SECONDS=10
CHECKPOINT_MIN_DELTA=1
CHECKPOINT_STALE_SECONDS=300
BRONZE_FILE_COUNT_WARN=5000
BRONZE_SMALL_FILE_BYTES=1048576
BRONZE_SMALL_FILE_RATIO_WARN=0.7

# Bronze maintenance
BRONZE_MAINTENANCE_SCHEDULE=0 */6 * * *
BRONZE_HEALTH_SCHEDULE=*/10 * * * *
BRONZE_MAINTENANCE_ENABLED=true
BRONZE_TABLE_PATH=s3a://bronze/mooc/bronze/mooc_events_raw
BRONZE_VACUUM_RETENTION_HOURS=168
